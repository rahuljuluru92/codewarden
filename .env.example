# xAI Grok API key (free tier). Get one at https://console.x.ai/
GROK_API_KEY=your-grok-api-key-here

# Base URL for the OpenAI-compatible Grok endpoint. Only change this if
# xAI changes their API host.
GROK_BASE_URL=https://api.x.ai/v1

# Model name to use for all agent roles (can be split per-role later).
GROK_MODEL=grok-2-latest

# Local path where ChromaDB persists its vector store.
CHROMA_DB_PATH=./chroma_db
