# Groq API key (console.groq.com/keys) — free tier.
GROQ_API_KEY=your-groq-api-key-here

# Base URL for the OpenAI-compatible Groq endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model name to use for all agent roles (can be split per-role later).
GROQ_MODEL=openai/gpt-oss-120b

# Local path where ChromaDB persists its vector store.
CHROMA_DB_PATH=./chroma_db
